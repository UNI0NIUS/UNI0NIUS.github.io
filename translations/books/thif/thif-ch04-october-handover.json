      ],
      "sourceItalic": true
    },
    {
      "id": "ch04-1401",
      "type": "paragraph",
      "page": "432",
      "en": [
        "4. Sendikal hareket"
      ],
      "zh": [
        "4．工会运动"
      ],
      "sourceItalic": true
    },
    {
      "id": "ch04-1402",
      "type": "paragraph",
      "page": "432",
      "en": [
        "5. Malî defter ve MK belgeleri"
      ],
      "zh": [
